{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "id":    { "type": "string", "minLength": 1 },
    "name":  { "type": "string", "minLength": 1 },
    "email": { "type": "string", "format": "email" },
    "age,approx":   { "type": "string", "pattern": "^[0-9]+$" }
  },
  "required": ["id", "name", "email", "age,approx"]
}
